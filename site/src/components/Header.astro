---
import { BASE, REPO, VERSION, href, num, otherLang, ui } from "../lib/site";
import type { Lang } from "../lib/site";

interface Props {
  lang: Lang;
  path: string;
  hasOther: boolean;
  current: "docs" | "try" | "home";
}
const { lang, path, hasOther, current } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
---

<header class="top">
  <div class="wrap">
    <button class="sq menu-btn" type="button" data-menu aria-label={t.menu} aria-expanded="false" aria-controls="side">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <a class="brand" href={href(lang)}>
      <img src={`${BASE}/logo.svg`} alt="" width="30" height="30" />
      <span>Kariz</span>
      <small>v{num(lang, VERSION)}</small>
    </a>
    <nav aria-label="Main">
      <a href={href(lang, "/docs/")} aria-current={current === "docs" ? "page" : undefined}>{t.docs}</a>
      <a href={href(lang, "/try/")} aria-current={current === "try" ? "page" : undefined}>{t.tryPanel}</a>
      <a href={REPO}>{t.github}</a>
    </nav>
    <div class="tools">
      <button class="sq searchbtn" type="button" data-search-open aria-label={t.search}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
        <span>{t.search}</span>
        <kbd>Ctrl K</kbd>
      </button>
      <button class="sq" type="button" data-theme-toggle aria-label={t.theme} title={t.theme}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
      </button>
      <button class="sq" type="button" data-low-toggle aria-pressed="false" aria-label={t.lowPower} title={t.lowPower}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14ZM5 19c2-4 5-7 9-9" /></svg>
      </button>
      {hasOther
        ? <a class="sq" href={href(other, path)} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{t.langSwitch}</a>
        : <span class="sq" style="opacity:.5" lang={other} title="—">{t.langSwitch}</span>}
    </div>
  </div>
</header>
