{
  "name": "kariz-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "dev": "npm run prepare-assets && astro dev",
    "build": "npm run prepare-assets && astro build && pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "check": "node scripts/check-translations.mjs && node scripts/check-links.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "mermaid": "^12.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
